# Copy to .env and fill in.

# Claude, for the classifier
ANTHROPIC_API_KEY=sk-ant-...

# Arcade, for the Slack send
ARCADE_API_KEY=arc_...
ARCADE_USER_ID=you@yourshelter.org   # the user Arcade acts AS; must be joined to target channels

# "slack" = really send via Arcade. "log" = skip sending, just record (safe fallback).
SEND_MODE=slack

# Backend port the frontend calls
PORT=3001
